# Nature Communications matplotlib style
# Single column: 88 mm = 3.46 in  |  Double column: 180 mm = 7.09 in
# Font: Helvetica via LaTeX helvet + sfmath  |  Colors: Okabe-Ito (colorblind-safe)

# ── LaTeX rendering ────────────────────────────────────────────────────────────
text.usetex        : True
text.latex.preamble: \usepackage{amsmath} \usepackage{amssymb} \usepackage{helvet} \usepackage{sfmath} \renewcommand{\familydefault}{\sfdefault}

# ── Font ───────────────────────────────────────────────────────────────────────
font.family    : sans-serif
font.sans-serif: Arial, Helvetica Neue, Helvetica, DejaVu Sans

# ── Font sizes (Nature Comm minimum: 5 pt at print size) ──────────────────────
font.size             : 8
axes.labelsize        : 8
axes.titlesize        : 8
xtick.labelsize       : 7
ytick.labelsize       : 7
legend.fontsize       : 7
legend.title_fontsize : 7

# ── Figure defaults (single column; override per-notebook with FIG_W / FIG_H) ─
figure.figsize: 3.46, 2.60
figure.dpi    : 150

# ── Lines ──────────────────────────────────────────────────────────────────────
lines.linewidth : 2.0
axes.linewidth  : 0.8
grid.linewidth  : 0.6

# ── Markers ────────────────────────────────────────────────────────────────────
lines.markersize: 5

# ── Grid ───────────────────────────────────────────────────────────────────────
axes.grid: False

# ── Legend ─────────────────────────────────────────────────────────────────────
legend.frameon       : False
legend.borderpad     : 0.3
legend.labelspacing  : 0.3
legend.handlelength  : 1.5
legend.handletextpad : 0.4
legend.columnspacing : 1.0

# ── Axes ───────────────────────────────────────────────────────────────────────
axes.labelpad    : 4
axes.titlepad    : 4
axes.spines.top  : False
axes.spines.right: False

# ── Ticks ──────────────────────────────────────────────────────────────────────
xtick.major.size : 3.5
xtick.major.width: 0.8
ytick.major.size : 3.5
ytick.major.width: 0.8
xtick.minor.size : 2.0
xtick.minor.width: 0.6
ytick.minor.size : 2.0
ytick.minor.width: 0.6
xtick.direction  : out
ytick.direction  : out

# ── Color cycle: Okabe-Ito (colorblind-safe, print-safe) ──────────────────────
# C0=sky-blue  C1=vermillion  C2=bluish-green  C3=orange
# C4=blue      C5=yellow      C6=reddish-purple C7=black
axes.prop_cycle: cycler(color=['56B4E9', 'D55E00', '009E73', 'E69F00', '0072B2', 'F0E442', 'CC79A7', '000000'])

# ── Save ───────────────────────────────────────────────────────────────────────
savefig.dpi       : 300
savefig.bbox      : tight
savefig.pad_inches: 0.05
savefig.format    : pdf
