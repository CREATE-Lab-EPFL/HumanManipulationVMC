# Custom matplotlib style for scientific plots with LaTeX

# Use LaTeX for text rendering
text.usetex : True
text.latex.preamble : \usepackage{amsmath} \usepackage{amssymb}

# Font sizes — all uniform; change TEXT_SIZE here to rescale everything together
# axes title is kept slightly larger for hierarchy
font.size             : 20
axes.labelsize        : 20
axes.titlesize        : 22
xtick.labelsize       : 20
ytick.labelsize       : 20
legend.fontsize       : 20
legend.title_fontsize : 20

# Font family
font.family : serif
font.serif : Computer Modern Roman

# Figure size (override per-notebook: set FIG_W/FIG_H then plt.rcParams['figure.figsize'] = [FIG_W, FIG_H])
figure.figsize : 10, 6
figure.dpi : 150

# Line widths
lines.linewidth : 2.5
axes.linewidth : 1.5
grid.linewidth : 1.0

# Marker sizes
lines.markersize : 10

# Grid
axes.grid : True
grid.alpha : 0.3
grid.linestyle : --

# Legend
legend.frameon : True
legend.framealpha : 0.9
legend.edgecolor : black

# Axes
axes.labelpad : 8
axes.titlepad : 12

# NPG (Nature Publishing Group) color palette — colorblind-friendly, print-safe
# C0=Blue/Cyan  C1=Red  C2=Teal  C3=Navy  C4=Coral  C5=Lavender  C6=Light Teal  C7=Bright Red  C8=Brown  C9=Gray
axes.prop_cycle : cycler(color=['4DBBD5', 'E64B35', '00A087', '3C5488', 'F39B7F', '8491B4', '91D1C2', 'DC0000', '7E6148', '949494'])

# Tick parameters
xtick.major.size : 6
xtick.major.width : 1.5
ytick.major.size : 6
ytick.major.width : 1.5

# Save figure settings
savefig.dpi : 300
savefig.bbox : tight
savefig.pad_inches : 0.1
savefig.format : pdf
